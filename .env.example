# Copia este archivo a backend/.env  (o ejecuta `python scripts/dev.py setup`, que lo crea con un secreto aleatorio).
# NUNCA subas .env a Git.
APP_ENV=development                         # development | test | staging | production
LOG_LEVEL=INFO

# Base de datos: SQLite (archivo local). Ruta relativa a la carpeta backend/.
DATABASE_URL=sqlite:///./data/kawsay.db

# Autenticación. OBLIGATORIO: >= 32 caracteres aleatorios (python -c "import secrets;print(secrets.token_hex(32))")
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=http://localhost:5173

# IA (opcional). Con AI_PROVIDER=disabled todo funciona; la adaptación con IA responde 503 y se usan variantes manuales.
AI_PROVIDER=disabled
# AI_PROVIDER=anthropic
# AI_MODEL=<modelo>
# AI_API_KEY=<clave, solo en el servidor>

# ML (opcional): permite mostrar un modelo NO aprobado, siempre con advertencia (solo demostraciones).
ML_ALLOW_EXPERIMENTAL=false

# Automatización n8n (opcional; ver automation/README.md). Secreto >= 16 caracteres, igual que en n8n.
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
