# Copia como .env; NO subas .env a GitHub.
# Genera 32+ caracteres aleatorios: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
APP_ENV=development
# localhost por defecto; para probar desde teléfonos en una LAN confiable, 0.0.0.0
WEB_BIND_IP=127.0.0.1
# Nginx envía /api al backend por la misma URL; CORS no se necesita.
CORS_ORIGINS=
AI_PROVIDER=disabled

# Tutor IA: modo local sin Internet exterior, desde la misma PC/servidor escolar.
# Primero instala Ollama y descarga un modelo (p. ej., ollama pull qwen2.5:3b).
# Configuración de ejemplo para ejecutar el backend desde la máquina escolar:
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_TIMEOUT_SECONDS=60
#
# Alternativa en línea (solo backend, NO en navegador o app):
# AI_PROVIDER=anthropic
# AI_MODEL=<modelo autorizado>
# AI_API_KEY=<clave privada>
#
# n8n: webhook del workflow 02_tutor_ia_alertas_educativas.json
# AUTOMATION_WEBHOOK_URL=https://tu-n8n.example/webhook/kawsay-educativo
# AUTOMATION_WEBHOOK_SECRET=<secreto HMAC fuerte igual al de n8n>
# AUTOMATION_AUTO_DISPATCH=true
# AUTOMATION_DISPATCH_INTERVAL_SECONDS=15
# Sin SMTP configurado en n8n, la notificación externa no se entregará.
